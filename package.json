{
  "name": "appium-qt-qaengine-driver",
  "description": "Appium and MCP adapter for qt-qaengine",
  "keywords": [
    "appium",
    "qt",
    "qt-qaengine"
  ],
  "version": "1.0.0",
  "author": "Andrei Kozhevnikov <coderusinbox@gmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderus/qt-qaengine-driver.git"
  },
  "bugs": {
    "url": "https://github.com/coderus/qt-qaengine-driver/issues"
  },
  "engines": [
    "node"
  ],
  "appium": {
    "driverName": "qtqaengine",
    "automationName": "QtQaEngine",
    "platformNames": [
      "QtQaEngine"
    ],
    "mainClass": "QtQaEngineDriver"
  },
  "main": "./build/index.js",
  "bin": {
    "qt-qaengine-mcp": "./build/mcp.js"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build",
    "LICENSE",
    "NOTICE",
    "OPEN_SOURCE_GRANT"
  ],
  "dependencies": {
    "@appium/support": "^4.0.0",
    "appium-base-driver": "^7.0.0"
  },
  "scripts": {
    "clean": "rm -rf node_modules && rm -f package-lock.json && npm install",
    "build": "gulp transpile",
    "mocha": "mocha",
    "prepare": "gulp prepublish"
  },
  "devDependencies": {
    "appium": "^2.15.0",
    "appium-gulp-plugins": "^5.0.0",
    "appium-qt-qaengine-driver": "file:.",
    "chai": "^4.1.2",
    "gulp": "^4.0.0",
    "mocha": "^10.0.0"
  }
}
